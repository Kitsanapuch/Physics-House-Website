# Template only. Do not put real credentials in this file or commit .env.local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional exact HTTPS production origin for a custom domain.
# Vercel preview URLs are accepted from VERCEL_URL / VERCEL_BRANCH_URL.
PH_PUBLIC_ORIGIN=
# Transactional update email. Create a Resend API key and verify the sender domain.
# All values are server-only secrets/settings in Vercel, never browser variables.
RESEND_API_KEY=
PH_EMAIL_FROM=
PH_ADMIN_NOTIFICATION_EMAIL=
# A long random value used only by Vercel Cron to retry queued mail.
CRON_SECRET=
